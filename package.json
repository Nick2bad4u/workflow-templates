{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "workflow-templates",
    "private": true,
    "description": "GitHub Actions workflow template repository.",
    "keywords": [
        "github-actions",
        "workflow-templates",
        "template-repository"
    ],
    "homepage": "https://github.com/Nick2bad4u/workflow-templates",
    "bugs": {
        "url": "https://github.com/Nick2bad4u/workflow-templates/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Nick2bad4u/workflow-templates.git"
    },
    "license": "MIT",
    "author": "Nick2bad4u <20943337+Nick2bad4u@users.noreply.github.com> (https://github.com/Nick2bad4u)",
    "scripts": {
        "build": "npm run build:runtime",
        "changelog:generate": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --output CHANGELOG.md",
        "changelog:preview": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --unreleased",
        "changelog:release-notes": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --current",
        "docs:actions:check": "node ./scripts/action-readmes.mjs",
        "docs:actions:update": "node ./scripts/action-readmes.mjs --write",
        "format": "npx prettier . --write",
        "format:check": "npx prettier . --check",
        "lint": "npx cross-env NODE_OPTIONS=--max_old_space_size=8192 npx eslint . --cache --cache-strategy content --cache-location .cache/.eslintcache",
        "lint:actions": "actionlint -color -shellcheck= -pyflakes=",
        "lint:all": "npm run lint && npm run validate:git-cliff-token && npm run format:check && npm run lint:gitleaks && npm run lint:yamllint",
        "lint:all:fix": "npm run lint:fix && npm run lint:remark:fix && npm run format",
        "lint:fix": "npx cross-env NODE_OPTIONS=--max_old_space_size=8192 npx eslint . --cache --cache-strategy content --cache-location .cache/.eslintcache --fix",
        "lint:git-cliff-token": "node ./scripts/validate-git-cliff-token-exports.mjs",
        "lint:gitleaks": "gitleaks dir --config .gitleaks.toml .",
        "lint:jscpd": "npx jscpd --config node_modules/jscpd-config-nick2bad4u/jscpd.json",
        "lint:lychee": "lychee --config node_modules/lychee-config-nick2bad4u/lychee.toml .",
        "lint:lychee:smoke": "lychee --config node_modules/lychee-config-nick2bad4u/lychee.toml --dump-inputs README.md",
        "lint:package-json": "npx npmPkgJsonLint . --config .npmpackagejsonlintrc.json",
        "lint:prettier": "npx prettier . --log-level warn --cache --cache-location=.cache/.prettier-cache --cache-strategy=content --check",
        "lint:prettier:fix": "npx prettier . --log-level warn --cache --cache-location=.cache/.prettier-cache --cache-strategy=content --write",
        "lint:publint": "npx publint",
        "lint:remark": "npx remark . --frail --ignore-path .remarkignore",
        "lint:remark:fix": "npx remark . --ignore-path .remarkignore --output",
        "lint:secretlint": "npx secretlint --secretlintrc .secretlintrc.cjs --secretlintignore .gitignore \"**/*\"",
        "lint:yamllint": "yamllint -c .yamllint .",
        "schema:check:workflow-template-properties": "node ./scripts/update-workflow-template-properties-schema.mjs && git diff --exit-code -- schemas/github-workflow-template-properties.schema.json",
        "schema:test:workflow-template-properties": "node ./scripts/validate-workflow-template-properties-schema-fixtures.mjs",
        "schema:update:workflow-template-properties": "node ./scripts/update-workflow-template-properties-schema.mjs",
        "test:git-cliff-token": "node --test ./test/git-cliff-token-exports.test.mjs",
        "typecheck": "npx tsc -p tsconfig.js.json --noEmit",
        "update-actions": "npx actions-up --yes --style sha",
        "update-deps": "npx ncu --configFileName .ncurc.json --configFilePath node_modules/ncu-config-nick2bad4u && npm update --all --force && npm install --force",
        "validate:git-cliff-token": "npm run test:git-cliff-token && npm run lint:git-cliff-token"
    },
    "devDependencies": {
        "@microsoft/tsdoc-config": "^0.18.1",
        "ajv": "^8.20.0",
        "eslint-config-nick2bad4u": "^11.0.1",
        "git-cliff": "^2.13.1",
        "gitcliff-config-nick2bad4u": "^1.4.0",
        "gitleaks-config-nick2bad4u": "^1.0.4",
        "jscpd": "^5.0.14",
        "jscpd-config-nick2bad4u": "^1.1.0",
        "lychee-config-nick2bad4u": "^2.0.0",
        "ncu-config-nick2bad4u": "^0.2.1",
        "npm-check-updates": "^23.0.0",
        "npm-package-json-lint": "^10.4.1",
        "npm-package-json-lint-config-nick2bad4u": "^1.0.4",
        "prettier": "^3.9.6",
        "prettier-config-nick2bad4u": "^1.1.1",
        "remark": "^15.0.1",
        "remark-cli": "^12.0.1",
        "remark-config-nick2bad4u": "^1.1.3",
        "secretlint": "^13.0.4",
        "secretlint-config-nick2bad4u": "^1.1.2",
        "tsdoc-config-nick2bad4u": "^1.0.6",
        "yamllint-config-nick2bad4u": "^1.1.1"
    },
    "packageManager": "npm@12.0.1",
    "engines": {
        "node": ">=22.18.0"
    }
}
